// Cloudflare Workers config: serves the static build in dist/. No Worker code.
{
  "name": "chrisanthony-xyz",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // chrisanthony-xyz.cjnanthony.workers.dev stays on as a fallback address.
  "workers_dev": true,
  // Legacy per-version preview links stay disabled; branch previews are separate.
  "preview_urls": false,
  "previews": {}
}
